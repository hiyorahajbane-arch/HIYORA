# Copy to server/.env (or just export the variables) before running in production.
# In development the server falls back to a built-in dev secret.
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma separated. Only needed when the client is served from another host.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
